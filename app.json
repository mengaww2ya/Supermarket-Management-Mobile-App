{
  "expo": {
    "name": "QUEEN",
    "slug": "QUEEN",
    "scheme": "QUEEN",
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "web": {
    "bundler": "metro"
    
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router"
    ],
    "orientation": "portrait",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "newArchEnabled": true

    },
    "android": {
       "newArchEnabled": true,

      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    }
  }
}
